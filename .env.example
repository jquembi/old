APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PORTAL_API_BASE_URL="${APP_URL}"
PORTAL_ALLOWED_ORIGINS="${APP_URL}"

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Luanda

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gterras
DB_USERNAME=root
DB_PASSWORD=

# Plataforma nacional / nodes provinciais. Cada servidor executa um só papel.
TENANT_DEPLOYMENT_MODE=node
TENANT_PRIMARY_DOMAIN=gterra.gov.ao
TENANT_CENTRAL_CONNECTION="${DB_CONNECTION}"
TENANT_NODE_CONNECTION="${DB_CONNECTION}"
TENANT_DEFAULT=HUI
TENANT_NODE_CODE=HUI
TENANT_NODE_NAME="Província da Huíla"
TENANT_NODE_DATABASE="${DB_DATABASE}"
TENANT_SUBDOMAIN_DOMAIN="${TENANT_PRIMARY_DOMAIN}"
TENANT_HEADER_NAME=X-Tenant
TENANT_QUERY_PARAMETER=tenant
TENANT_CENTRAL_URL=https://gterra.gov.ao
TENANT_SYNC_TOKEN=
TENANT_SYNC_ENABLED=true
TENANT_SYNC_INTERVAL=30
TENANT_SYNC_RETRY=3
TENANT_SYNC_BATCH_SIZE=100
TENANT_SYNC_CONNECT_TIMEOUT=3
TENANT_SYNC_TIMEOUT=10
TENANT_SYNC_BACKOFF_MINUTES=5

# Angola GeoGuard: inicia em observação para calibrar antes de bloquear.
ANGOLA_GEOGUARD_ENABLED=true
ANGOLA_GEOGUARD_FAILURE_MODE=observe
ANGOLA_GEOGUARD_OBSERVATION_MODE=true
ANGOLA_GEOGUARD_AUDIT_ENABLED=true
ANGOLA_GEOGUARD_AUDIT_STORE_IP=false
ANGOLA_GEOGUARD_AUDIT_STORE_COORDINATES=false
ANGOLA_GEOGUARD_TENANCY_ENABLED=true
ANGOLA_GEOGUARD_SPATIAL_ENGINE=memory
ANGOLA_GEOGUARD_TRUSTED_PROXIES=

# Rule Manager: ACL institucional, separado do ACL legado durante a migração.
RULE_MANAGER_PLANO=corporativo
RULE_MANAGER_MULTI_EMPRESA=false
RULE_MANAGER_CACHE_STORE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ERROR_NOTIFICATIONS_ENABLED=false
ERROR_NOTIFICATION_EMAIL="${MAIL_FROM_ADDRESS}"
ERROR_NOTIFICATION_THROTTLE_MINUTES=10
LIBREOFFICE_BINARY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
