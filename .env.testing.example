APP_NAME=G.TERRAS
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Luanda

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gterras_testing
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="testing@gterras.local"
MAIL_FROM_NAME="${APP_NAME}"

ERROR_NOTIFICATIONS_ENABLED=false
ERROR_NOTIFICATION_EMAIL="${MAIL_FROM_ADDRESS}"
ERROR_NOTIFICATION_THROTTLE_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
